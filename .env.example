# Copy this file to .env.local and fill in values. Never commit .env.local.

# PostgreSQL (with pgvector extension). Matches docker-compose.yml defaults.
DATABASE_URL=postgresql://tracevault:tracevault@localhost:5432/tracevault

# Optional: only needed if the vector store lives in a separate database.
# If unset, the app uses DATABASE_URL (pgvector inside the same Postgres).
VECTOR_DATABASE_URL=

# Secret used to sign login tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me

# Embedding provider (decide model in Phase 0; dimension must match VECTOR(n) in DDL)
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
